  if(geoBusy)return;geoBusy=true;
  try{
    while(geoQueue.length){
      if(typeof navigator!=="undefined"&&navigator.onLine===false){geoQueue.length=0;break;}
      var it=geoQueue.shift();
      try{if(await geoResolve(it))geoRerender();}catch(e){}
    }
  }finally{geoBusy=false;}
