/* ---------- création de facture (numérotation continue, année de la facture) ---------- */
function newFacture(cpt,o){
  const date=o.date||todayISO(),year=date.slice(0,4);
  cpt.seq[year]=(cpt.seq[year]||0)+1;
  const ttc=+(+o.ttc||0).toFixed(2),ht=o.ht!=null?+(+o.ht).toFixed(2):+(ttc/1.2).toFixed(2),tva=+(ttc-ht).toFixed(2);
  const f={id:"f"+Date.now()+Math.random().toString(36).slice(2,5),num:"F"+year+"-"+String(cpt.seq[year]).padStart(3,"0"),
    client:o.client||"",adresse:o.adresse||"",date,dateprest:o.dateprest||"",objet:o.objet||"Diagnostics immobiliers",
    ht,tvaRate:ht?+(tva/ht).toFixed(2):0.2,tva,ttc,statut:o.paye?"paye":"attente",mode:o.mode||"Virement"};
  if(o.paye)f.datePaiement=todayISO();
  if(o.devisId)f.devisId=o.devisId;
  if(o.missionId)f.missionId=o.missionId;
  cpt.factures.push(f);
  return f;
}
