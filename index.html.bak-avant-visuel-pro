.view .card .card-h .hint,.view .card .act .am,.view .card .act .tm,.view .card .rdv .what,.view .kpi .h,.view .kpi .l,.view .card .es-s,.view table.tbl th{color:var(--muted);}
.floader{color:var(--on-bg-2);}
.frames iframe{background:transparent;}

.tarifs{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px 22px;}
.tarif{display:grid;grid-template-columns:1fr 150px 56px;align-items:center;gap:12px;padding:7px 0;border-bottom:1px solid var(--line);}
.tarif:last-child{border-bottom:none;}
.tarif .tn{font-size:13.5px;font-weight:600;color:var(--ink);}
.tarif input[type=range]{width:100%;accent-color:var(--green);}
.tarif .tv{font-size:13px;font-weight:700;color:var(--ink);text-align:right;font-variant-numeric:tabular-nums;}
@media(max-width:560px){.tarif{grid-template-columns:1fr 100px 52px;}}

.view .btn.green,.view .btn.green svg,.view .btn.dark,.view .btn.dark svg,.btn.green,.btn.green svg,.side-btn.primary,.side-btn.primary svg,.tag.green,.badge.green{color:#fff;}

@media (prefers-reduced-motion:reduce){ *{transition:none!important;animation:none!important;} }

/* ===== Logiciels : bande du haut réduite à la cloche (plus de survol de l'iframe) ===== */
.content{position:relative;}
.content.mod-mode .app-topbar{flex:0 0 auto;position:relative;padding:6px 10px 0;z-index:30;}
.content.mod-mode .notif-bell{width:34px;height:34px;border-radius:10px;background:rgba(58,63,59,.92);border-color:rgba(255,255,255,.35);box-shadow:0 4px 14px rgba(20,24,21,.25);}
.content.mod-mode .notif-bell svg{width:18px;height:18px;}
@media (max-width:820px){.content.mod-mode .app-topbar{padding:4px 6px 0;}}
/* ===== Pilotage semi-automatique ===== */
.todo-card .card-h .hint{font-weight:700;color:var(--green-d);}
.todo-list{display:flex;flex-direction:column;}
.todo-item{display:flex;gap:12px;align-items:flex-start;padding:12px 2px;border-bottom:1px solid var(--line-2);}
.todo-item:last-of-type{border-bottom:none;}
.todo-item .notif-ic{flex:0 0 auto;margin-top:2px;}
.todo-body{flex:1;min-width:0;}
.todo-title{font-weight:700;font-size:13.5px;color:var(--ink);line-height:1.35;}
.todo-sub{font-size:12.5px;color:var(--muted);margin-top:2px;}
.todo-acts{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px;}
.todo-acts .btn.sm{padding:5px 10px;font-size:12px;}
.todo-acts .todo-skip{background:transparent;border-color:transparent;color:var(--muted);}
.todo-acts .todo-skip:hover{color:var(--ink);background:var(--line-2);}
.todo-empty{display:flex;gap:10px;align-items:center;padding:14px 4px;font-size:13px;color:var(--muted);}
.todo-empty svg{width:22px;height:22px;flex:0 0 auto;color:var(--green);stroke-width:2.2;}
.todo-more{margin-top:8px;background:none;border:none;color:var(--green-d);font-weight:700;font-size:12.5px;padding:6px 2px;cursor:pointer;}
.notif-ic.green{background:var(--green-soft);color:var(--green-d);}
.tag.late{background:var(--red-soft);color:var(--red);}
.tag.todo{background:var(--blue-soft);color:var(--blue);}
