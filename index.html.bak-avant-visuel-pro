<!DOCTYPE html>
<html lang="fr"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Burdigala Diagnostics — Centre de gestion</title>
<link rel="manifest" href="manifest.json">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<meta name="theme-color" content="#1A1F1C">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Burdigala CRM">

<style>
:root{
  --bg:#F3F5F0; --card:#FFFFFF; --line:#D2DCC8; --line-2:#E6ECE0;
  --ink:#3A3F3B; --ink-2:#4C514D; --muted:#6E736F;
  --green:#6DB33F; --green-d:#5a9e30; --green-soft:#EDF7E2; --green-tint:#F4FAEC;
  --amber:#e67e22; --amber-soft:#fef4e0; --red:#c0392b; --red-soft:#fdeae7; --blue:#3E6FA3; --blue-soft:#EAF1F8;
  --side:#1A1F1C; --side-2:#242B23; --side-tx:#9BA491; --side-hd:#748069;
  --r:16px; --r-sm:10px;
  --sh:0 4px 18px rgba(26,31,28,.04); --sh-h:0 10px 30px rgba(26,31,28,.08);
  --bg-grad:linear-gradient(180deg,#343835 0%,#4C514D 18%,#6E736F 38%,#9DA29E 62%,#C4C8C4 82%,#D8DBD7 100%);
  --on-bg:#FFFFFF; --on-bg-2:rgba(255,255,255,.78);
}
*{box-sizing:border-box;}
#loginGate{position:fixed;inset:0;z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;padding:40px 20px;background:var(--bg-grad);}
#loginGate.hidden{display:none;}
#loginGate .lg-logo{width:min(420px,80vw);height:auto;display:block;}
#loginGate .lg-card{width:100%;max-width:380px;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:26px 26px 22px;box-shadow:0 20px 50px rgba(20,24,21,.28);}
#loginGate form{display:flex;flex-direction:column;gap:14px;}
#loginGate .lg-field{display:flex;flex-direction:column;gap:6px;}
#loginGate .lg-field label{font-size:11.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);}
#loginGate .lg-inp{font-family:inherit;font-size:14px;color:var(--ink);background:#fff;border:1px solid var(--line);border-radius:10px;padding:11px 12px;width:100%;transition:border-color .14s,box-shadow .14s;}
#loginGate .lg-inp::placeholder{color:#A3A8A3;}
#loginGate .lg-inp:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px rgba(109,179,63,.2);}
#loginGate .lg-pw{position:relative;}
#loginGate .lg-pw .lg-inp{padding-right:62px;}
#loginGate .lg-see{position:absolute;right:6px;top:50%;transform:translateY(-50%);background:none;border:none;font-family:inherit;font-size:12px;font-weight:700;color:var(--muted);cursor:pointer;padding:6px 8px;border-radius:7px;}
#loginGate .lg-see:hover{color:var(--ink);background:#F3F5F2;}
#loginGate .lg-cta{font-family:inherit;font-size:14.5px;font-weight:700;color:#fff;background:var(--green);border:1px solid var(--green);border-radius:10px;padding:12px 16px;cursor:pointer;transition:filter .14s;}
#loginGate .lg-cta:hover{filter:brightness(1.07);}
#loginGate .lg-cta:disabled{opacity:.6;cursor:default;}
#loginGate .lg-err{display:none;font-size:13px;font-weight:600;color:var(--red);background:var(--red-soft);border:1px solid #EBD2CE;border-radius:9px;padding:9px 11px;}
#loginGate .lg-err.show{display:block;}
#loginGate .lg-switch{font-size:12.5px;color:var(--muted);text-align:center;}
#loginGate .lg-switch a{color:var(--green);font-weight:700;cursor:pointer;}

html,body{margin:0;height:100%;}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;color:var(--ink);background:var(--bg-grad);background-attachment:fixed;
  -webkit-font-smoothing:antialiased;line-height:1.5;font-size:14px;}
button{font-family:inherit;cursor:pointer;} a{color:inherit;text-decoration:none;}
svg{fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;}
::-webkit-scrollbar{width:10px;height:10px;} ::-webkit-scrollbar-thumb{background:#c7d1ba;border-radius:6px;border:2px solid var(--bg);}
.app{display:flex;height:100vh;overflow:hidden;}

/* ---------- Sidebar ---------- */
.side{width:250px;flex:0 0 250px;background:#3A3F3B;color:#fff;display:flex;flex-direction:column;z-index:56;border:none;border-right:4px solid #fff;border-radius:0;margin:0;overflow:hidden;box-shadow:inset -15px 0 15px -6px rgba(255,255,255,.24),0 14px 38px rgba(20,24,21,.35);}
.side-brand{padding:18px 2px 15px;border-bottom:1.5px solid rgba(255,255,255,.35);flex:0 0 auto;}
button.side-brand{background:none;border:none;border-bottom:1.5px solid rgba(255,255,255,.35);width:100%;display:block;cursor:pointer;}
.side-brand img{width:244px;height:69px;max-width:none;display:block;margin:0 auto;image-rendering:auto;}
.side-nav{padding:14px 10px;flex:1;overflow:hidden;display:flex;flex-direction:column;justify-content:flex-start;}
.side-nav::-webkit-scrollbar{display:none;}
@media (max-height:760px){
  .nsec{padding:12px 10px 5px;font-size:11px;}
  .nav-item{padding:6px 11px;margin-bottom:1px;font-size:13px;}
  .side-brand{padding:12px 2px 10px;}
}
@media (max-height:620px){
  .nsec{padding:7px 10px 3px;font-size:10px;}
  .nav-item{padding:4px 11px;margin-bottom:0;font-size:12.5px;}
  .nav-item svg{width:15px;height:15px;}
  .side-brand{padding:8px 2px 7px;}
  .side-foot{padding:7px;}
  .side-btn{padding:7px 10px;font-size:12px;}
}
.side-nav::-webkit-scrollbar-thumb{background:rgba(255,255,255,.35);border:2px solid transparent;}
.nsec{font-size:11.5px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#fff;padding:20px 10px 7px;}
.nav-item{display:flex;align-items:center;gap:11px;padding:9px 11px;border-radius:9px;color:#fff;font-size:14.5px;font-weight:600;width:100%;text-align:left;background:none;border:none;cursor:pointer;position:relative;margin-bottom:2px;transition:background .12s,color .12s;}
.nav-item svg{width:18px;height:18px;color:#fff;flex:0 0 auto;transition:color .12s;}
.nav-item:hover{background:rgba(255,255,255,.14);color:#fff;} .nav-item:hover svg{color:#fff;}
.nav-item.active{background:rgba(109,179,63,.28);color:#fff;} .nav-item.active svg{color:#fff;}
.nav-item.active::before{content:"";position:absolute;left:1px;top:8px;bottom:8px;width:3px;border-radius:0 3px 3px 0;background:var(--green);}
.nav-item .badge{margin-left:auto;background:rgba(255,255,255,.22);color:#fff;font-size:11px;font-weight:700;border-radius:999px;padding:1px 8px;}
.side-foot{padding:10px;border-top:1.5px solid rgba(255,255,255,.35);flex:0 0 auto;}
.user{display:flex;align-items:center;gap:10px;padding:8px 8px 10px;}
.ava{width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,var(--green),var(--green-d));color:#fff;font-weight:700;font-size:14px;display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
.user .un{font-size:13px;font-weight:700;color:#fff;} .user .ur{font-size:11px;color:#fff;}
.side-actions{display:flex;flex-direction:column;gap:8px;margin-top:10px;}
.side-btn{display:flex;align-items:center;justify-content:center;gap:7px;width:100%;border:1.5px solid rgba(255,255,255,.35);background:rgba(255,255,255,.12);color:#fff;border-radius:9px;padding:9px 12px;font-size:12.5px;font-weight:600;font-family:inherit;cursor:pointer;transition:all .15s;}
.side-btn:hover{background:rgba(255,255,255,.2);border-color:#fff;color:#fff;}
.side-btn svg{width:15px;height:15px;flex:0 0 auto;}
.side-btn.primary{background:var(--green);border-color:var(--green);color:#fff;}
.side-btn.primary:hover{background:var(--green-d);border-color:var(--green-d);}

/* ---------- Content ---------- */
.content{flex:1;min-width:0;display:flex;flex-direction:column;height:100vh;background:var(--bg-grad);}
.btn{display:inline-flex;align-items:center;gap:7px;border:1.5px solid var(--line);background:var(--card);color:var(--ink-2);border-radius:10px;padding:9px 15px;font-size:13.5px;font-weight:600;font-family:inherit;transition:all .15s;}
.btn:hover{border-color:var(--green);}
.btn svg{width:15px;height:15px;}
.btn.dark{background:var(--ink);border-color:var(--ink);color:#fff;} .btn.dark:hover{opacity:.9;border-color:var(--ink);}
.btn.green{background:var(--green);border-color:var(--green);color:#fff;} .btn.green:hover{background:var(--green-d);border-color:var(--green-d);}
.btn:disabled{opacity:.45;cursor:not-allowed;pointer-events:none;}
.btn.sm{padding:6px 11px;font-size:12.5px;border-radius:8px;}
.btn:focus-visible{outline:2px solid var(--green);outline-offset:2px;}

.body{flex:1;position:relative;min-height:0;}
.pages{position:absolute;inset:0;overflow-y:auto;}

/* framehost (modules) */
.framehost{position:absolute;inset:0;display:none;flex-direction:column;background:var(--bg-grad);}
.framehost.active{display:flex;}
.frames{flex:1;position:relative;}
.frames iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:none;background:#fff;}
.frames iframe.active{display:block;}
.floader{position:absolute;inset:0;display:none;flex-direction:column;align-items:center;justify-content:center;gap:12px;background:var(--bg-grad);color:var(--muted);font-size:13px;font-weight:600;}
.floader.show{display:flex;}
.spin{width:26px;height:26px;border:2.5px solid var(--line);border-top-color:var(--green);border-radius:50%;animation:sp .7s linear infinite;}
@keyframes sp{to{transform:rotate(360deg);}}

.view{padding:24px 28px 44px;max-width:1220px;}
.view.hidden{display:none;}
.hidden{display:none!important;}
.hello{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;flex-wrap:wrap;}
.hello h2{font-family:inherit;font-weight:700;font-size:25px;letter-spacing:-.4px;margin:0 0 3px;}
.hello p{margin:0;color:var(--muted);font-size:13.5px;}

.kpis{display:grid;gap:14px;grid-template-columns:repeat(4,1fr);margin-top:22px;}
.kpi{background:var(--card);border:1.5px solid var(--line);border-radius:14px;padding:16px 17px;box-shadow:var(--sh);transition:box-shadow .15s,transform .15s;}
.kpi:hover{box-shadow:var(--sh-h);transform:translateY(-2px);}
.kpi-link{display:block;width:100%;text-align:left;font:inherit;color:inherit;cursor:pointer;-webkit-appearance:none;appearance:none;}
.kpi-link:hover{border-color:var(--green);}
.kpi .h{display:flex;align-items:center;gap:9px;color:var(--muted);font-size:12px;font-weight:600;}
.kpi .ic{width:28px;height:28px;border-radius:9px;background:var(--green-tint);color:var(--green-d);display:flex;align-items:center;justify-content:center;flex:0 0 auto;}
.kpi .ic svg{width:16px;height:16px;}
.kpi .ic.amber{background:var(--amber-soft);color:var(--amber);} .kpi .ic.blue{background:var(--blue-soft);color:var(--blue);}
.kpi .v{font-size:26px;font-weight:700;letter-spacing:-.5px;line-height:1;margin-top:13px;font-variant-numeric:tabular-nums;}
.kpi .l{font-size:12px;color:var(--muted);margin-top:6px;}

.grid{display:grid;gap:16px;margin-top:16px;}
.g-2{grid-template-columns:1.5fr 1fr;}
.card{background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);box-shadow:var(--sh);}
.card-h{display:flex;align-items:center;justify-content:space-between;padding:15px 18px;border-bottom:1.5px solid var(--line-2);}
.card-h h3{font-family:inherit;font-weight:700;font-size:16px;margin:0;display:flex;align-items:center;gap:9px;}
.card-h h3::before{content:'';width:16px;height:3px;background:var(--green);border-radius:2px;}
.card-h .hint{font-size:11.5px;color:var(--muted);}
.card-h button{font-size:12px;font-weight:600;color:var(--green-d);background:none;border:none;cursor:pointer;}
.card-b{padding:8px 18px 16px;}

/* chart */
.chart{padding:16px 18px 8px;}
.bars{display:flex;align-items:flex-end;gap:12px;height:170px;padding-top:8px;}
.bcol{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:flex-end;}
.bwrap{width:100%;flex:1;display:flex;align-items:flex-end;}
.bar{width:100%;max-width:34px;margin:0 auto;background:linear-gradient(180deg,#7cc04b,var(--green-d));border-radius:6px 6px 3px 3px;min-height:3px;transition:height .5s cubic-bezier(.2,.8,.2,1);}
.bl{font-size:11px;color:var(--muted);font-weight:600;} .bv{font-size:10.5px;color:var(--ink-2);font-weight:700;font-variant-numeric:tabular-nums;}

/* lists */
.act{display:flex;gap:11px;padding:11px 0;border-bottom:1px solid var(--line-2);align-items:center;}
.act:last-child{border-bottom:none;}
.act .ai{width:31px;height:31px;border-radius:9px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;}
.act .ai svg{width:15px;height:15px;} .ai.g{background:var(--green-soft);color:var(--green-d);} .ai.b{background:var(--blue-soft);color:var(--blue);} .ai.a{background:var(--amber-soft);color:var(--amber);}
.act .at{font-size:13px;font-weight:600;line-height:1.25;} .act .am{font-size:11.5px;color:var(--muted);margin-top:1px;} .act .tm{margin-left:auto;font-size:11px;color:var(--muted);white-space:nowrap;}
.rdv{display:flex;gap:12px;padding:11px 0;border-bottom:1px solid var(--line-2);align-items:center;} .rdv:last-child{border-bottom:none;}
.rdv .w{flex:0 0 50px;text-align:center;} .rdv .w .d{font-size:10.5px;color:var(--muted);} .rdv .w .h{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums;}
.rdv .bar2{width:2px;align-self:stretch;background:var(--green);border-radius:2px;}
.rdv .who{font-size:13px;font-weight:600;} .rdv .what{font-size:11.5px;color:var(--muted);margin-top:1px;}


/* tables */
.vhead{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;margin-bottom:6px;}
.vhead .lead{color:var(--muted);font-size:13.5px;margin:0;}
.search{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:9px;background:#fff;padding:0 12px;max-width:320px;}
.search svg{width:16px;height:16px;color:var(--muted);} .search input{border:none;outline:none;padding:9px 0;font:inherit;font-size:13.5px;flex:1;background:none;}
.tbl-wrap{overflow-x:auto;max-width:100%;}
table.tbl{width:100%;border-collapse:collapse;min-width:560px;}
table.tbl th{font-size:11.5px;color:var(--muted);font-weight:600;text-align:left;padding:11px 16px;border-bottom:1.5px solid var(--line);}
table.tbl td{padding:12px 16px;border-bottom:1px solid var(--line-2);font-size:13px;}
.tbl-inp{width:100%;min-width:0;max-width:170px;box-sizing:border-box;border:1px solid var(--line);border-radius:7px;padding:5px 8px;font:inherit;font-size:12.5px;color:var(--ink);background:#fff;text-overflow:ellipsis;}
.tbl-inp:focus{outline:none;border-color:var(--green);}
table.tbl tr:last-child td{border-bottom:none;} table.tbl tr:hover td{background:var(--bg);}
.tag{display:inline-block;font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
.tag.ok{color:#3d6b1f;background:var(--green-soft);} .tag.wait{color:#b9770f;background:var(--amber-soft);} .tag.no{color:var(--red);background:var(--red-soft);} .tag.info{color:var(--blue);background:var(--blue-soft);}
.num{font-variant-numeric:tabular-nums;font-weight:600;}

/* empty state */
.es{display:flex;flex-direction:column;align-items:center;text-align:center;padding:34px 20px;}
.es .ei{width:52px;height:52px;border-radius:14px;background:var(--green-tint);color:var(--green-d);display:flex;align-items:center;justify-content:center;margin-bottom:14px;} .es .ei svg{width:25px;height:25px;}
.es-t{font-size:14.5px;font-weight:700;} .es-s{font-size:12.5px;color:var(--muted);margin-top:5px;max-width:340px;line-height:1.5;}
.es .btn{margin-top:15px;}

.sys{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px;}
.sys-i{display:flex;align-items:center;gap:11px;background:var(--card);border:1.5px solid var(--line);border-radius:var(--r);padding:14px 16px;box-shadow:var(--sh);}
.sys-i .si{width:34px;height:34px;border-radius:9px;background:var(--green-tint);color:var(--green-d);display:flex;align-items:center;justify-content:center;} .sys-i .si svg{width:18px;height:18px;}
.sys-i .k{font-size:12.5px;font-weight:700;} .sys-i .st{font-size:11.5px;color:var(--green-d);font-weight:600;}
.grp{margin-top:22px;} .grp-h{margin:0 0 12px;} .grp-h h3{font-size:12.5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);margin:0;}
.field{margin:12px 0;max-width:440px;} .field label{display:block;font-size:12px;font-weight:700;color:var(--ink-2);margin-bottom:6px;}
.field .inp{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:9px;padding:0 12px;background:#fff;}
.field .inp:focus-within{border-color:var(--green);box-shadow:0 0 0 3px rgba(109,179,63,.13);}
.field .inp svg{width:16px;height:16px;color:var(--muted);} .field input{border:none;outline:none;padding:10px 0;font:inherit;font-size:13.5px;flex:1;background:none;}
.flow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:6px 0 14px;} .flow .s{background:var(--bg);border:1.5px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12px;font-weight:600;} .flow .ar{color:var(--green-d);font-weight:700;}
.row{display:flex;gap:10px;flex-wrap:wrap;}

.scrim{display:none;position:fixed;inset:0;background:rgba(26,31,28,.45);z-index:54;}
.botnav{display:none;}
.toast{position:fixed;bottom:22px;left:50%;transform:translateX(-50%) translateY(14px);background:var(--ink);color:#fff;padding:11px 18px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 12px 30px rgba(26,31,28,.3);opacity:0;transition:.22s;z-index:120;pointer-events:none;}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}

.app-topbar{flex:0 0 auto;display:flex;align-items:center;justify-content:flex-end;padding:14px 24px 0;}
.notif-wrap{position:relative;}
.notif-bell{position:relative;width:40px;height:40px;border-radius:12px;border:1.5px solid rgba(255,255,255,.3);background:rgba(255,255,255,.14);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .15s,transform .15s;}
.notif-bell:hover{background:rgba(255,255,255,.22);}
.notif-bell svg{width:19px;height:19px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.notif-count{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 4px;border-radius:999px;background:var(--red);color:#fff;font-size:10.5px;font-weight:800;display:flex;align-items:center;justify-content:center;line-height:1;box-shadow:0 0 0 2px rgba(0,0,0,.22);}
.notif-count.hidden{display:none;}
.notif-panel{position:absolute;top:calc(100% + 10px);right:0;width:370px;max-width:calc(100vw - 32px);max-height:min(70vh,520px);overflow:auto;background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:0 20px 50px rgba(20,24,21,.22);z-index:80;}
.notif-panel.hidden{display:none;}
.notif-panel-head{display:flex;align-items:center;justify-content:space-between;padding:14px 16px;border-bottom:1px solid var(--line-2);position:sticky;top:0;background:var(--card);z-index:1;}
.notif-panel-head h4{font-size:14px;margin:0;}
.notif-panel-head span{font-size:11.5px;color:var(--muted);font-weight:700;}
.notif-list{padding:6px;}
.notif-empty{padding:30px 16px;text-align:center;color:var(--muted);font-size:13px;}
.notif-item{display:flex;gap:10px;align-items:flex-start;padding:10px;border-radius:10px;cursor:pointer;}
.notif-item:hover{background:var(--green-tint);}
.notif-ic{flex:0 0 auto;width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;background:var(--amber-soft);color:var(--amber);}
.notif-ic svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
.notif-ic.blue{background:var(--blue-soft);color:var(--blue);}
.notif-ic.red{background:var(--red-soft);color:var(--red);}
.notif-body{flex:1;min-width:0;}
.notif-title{font-size:12.5px;font-weight:700;color:var(--ink);}
.notif-sub{font-size:11.5px;color:var(--muted);margin-top:2px;}
.notif-check{flex:0 0 auto;width:25px;height:25px;margin-top:2px;border-radius:8px;border:1.5px solid var(--line);background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--muted);}
