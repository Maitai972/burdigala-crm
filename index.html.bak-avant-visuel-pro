  table.tbl td::before{content:attr(data-label);color:var(--muted);font-weight:600;text-align:left;flex:0 0 auto;} table.tbl td[data-label=""]::before{content:none;}
  table.tbl td .tbl-inp{flex:1 1 auto;min-width:0;max-width:60%;}
  table.tbl tr:hover td{background:none;}
}
/* ---------- Texte posé directement sur le fond dégradé ---------- */
.view{color:var(--on-bg);}
